# Lexema Worker — configuración completa vía variables de entorno.
# Copia este archivo a .env (servidor local) o configúralo como secrets
# de wrangler en producción. Todo es opcional salvo la API key.

# ── Proveedor de IA ─────────────────────────────────────────────
# gemini | openai | openrouter | groq
# Si no se define: usa gemini si hay GEMINI_API_KEY, si no openai (OpenRouter).
#AI_PROVIDER=openrouter

# Clave de API. Usa la genérica o la específica del proveedor:
#AI_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=

# Endpoint base del proveedor (se autodetecta según AI_PROVIDER).
# Útil para OpenRouter, Groq, Together, un LLM local (Ollama, llama.cpp), etc.
#AI_BASE_URL=https://openrouter.ai/api/v1

# Modelo por defecto (si la CLI no envía -m).
#AI_DEFAULT_MODEL=openrouter/auto

# Lista blanca de modelos separados por coma. Vacío = SIN RESTRICCIÓN:
# cualquiera con la URL del endpoint puede pedir el modelo que quiera.
# Si el proveedor es de pago y el endpoint es público, configurala siempre.
#AI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Instrucción de sistema que se antepone a cada prompt.
#SYSTEM_PROMPT=Responde en español, de forma concisa.

# ── Control de acceso ───────────────────────────────────────────
# Token compartido que la CLI envía como "Authorization: Bearer <token>".
# Vacío = endpoint abierto (cualquiera con la URL puede gastar tu cuota).
#CLIENT_TOKEN=

# Límites (aplican igual en local y en Cloudflare)
#MAX_PROMPT_LENGTH=4000
#DAILY_LIMIT=100

# ── Actualizaciones de la CLI ───────────────────────────────────
# El updater se sirve SIEMPRE en GET /download; la lógica de versiones
# vive dentro del propio archivo (ELF/EXE nativo compilado de C++), no
# en el servidor. La CLI envía ?platform= y el server elige del mapa
# UPDATER_FILES de src/server.ts: linux -> public/update.elf,
# win32 -> public/update.exe (fallback: public/test.sh).
# UPDATE_FILE tiene prioridad sobre el mapa (fuerza un único archivo).
#UPDATE_FILE=public/update.elf
# En Cloudflare no hay disco: sirve una URL remota con pasarela fetch;
# {platform} se sustituye por lo que envíe la CLI (linux, win32, ...).
#UPDATE_URL=https://ejemplo.com/updater/{platform}.bin

# ── Solo servidor local (npm run dev:node) ──────────────────────
#PORT=8787
